+#include <spawn.h>
+#include <sys/wait.h>
 #include <sys/sysinfo.h>
 
 #include "bench.h"
@@ -29,6 +31,28 @@
 using namespace std;
 using namespace util;
 
+extern char **environ;
+
+// SSP: run the measurement script named by $envname, if that variable is set.
+// Uses posix_spawn, not system()/fork(): glibc implements it with
+// clone(CLONE_VM|CLONE_VFORK), so the loaded DB's page tables are not copied.
+// A real fork() would write-protect tens of GB of PTEs, causing a storm of COW
+// faults and interfering with Nomad's shadow page faults.
+static void
+ssp_hook(const char *envname)
+{
+  const char *cmd = getenv(envname);
+  if (!cmd)
+    return; // unset (e.g. host-side calibration): do nothing
+  char * const argv[] = { (char *) "/bin/sh", (char *) "-c",
+                          (char *) cmd, nullptr };
+  pid_t pid;
+  if (posix_spawn(&pid, "/bin/sh", nullptr, nullptr, argv, environ) == 0)
+    waitpid(pid, nullptr, 0);
+  else
+    perror("posix_spawn");
+}
+
 size_t nthreads = 1;
 volatile bool running = true;
 int verbose = 0;
